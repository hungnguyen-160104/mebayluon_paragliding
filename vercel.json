{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "sin1"
  ],
  "crons": [
    {
      "path": "/api/cron/thoi-tiet-mail",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/camera-snap",
      "schedule": "* 0-12,22-23 * * *"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "dev": false
    }
  },
  "ignoreCommand": "[ -n \"$VERCEL_GIT_PREVIOUS_SHA\" ] && git diff --quiet \"$VERCEL_GIT_PREVIOUS_SHA\" HEAD -- . ':(exclude)*.md' ':(exclude)docs/**' ':(exclude)tests/**' ':(exclude).claude/**'"
}
