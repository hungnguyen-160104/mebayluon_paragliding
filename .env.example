# Mẫu biến môi trường — KHÔNG ghi giá trị bí mật ở đây.
# Danh sách đầy đủ các biến cũ xem README.md; tệp này mới ghi các biến camera.

# Khoá gọi các đường /api/cron/* (Vercel Cron, Cloudflare Worker, gọi tay ?key=)
CRON_SECRET=
# Ảnh camera lưu ở Cloudinary, danh mục ở MongoDB
CLOUDINARY_URL=
MONGODB_URI=

# ------------------------------------------------------------------
# CAMERA IMOU bãi cao Viên Nam (/baobay) — chụp 1 ảnh/phút 08:00–18:00
# Imou Open Platform → Console → My App → App Information
# ------------------------------------------------------------------
IMOU_APP_ID=lcdc5a22623c8c40e2
# BÍ MẬT — chỉ đặt trên Vercel / .env.local
IMOU_APP_SECRET=
# (Tuỳ chọn) mặc định trung tâm dữ liệu Đông Á: https://openapi-sg.easy4ip.com/openapi
IMOU_API_BASE=
# Số serial camera (dưới đáy máy)
IMOU_CAM_VIENNAM_SN=
# Mã an toàn 6 số dưới đáy máy — chỉ dùng khi tự bindDevice lần đầu
IMOU_CAM_VIENNAM_CODE=
